<div class="todo-app">
  <header class="app-header">
    <h1 class="app-title">
      <span class="icon">✏️</span>
      Edit Todo
    </h1>
    <%= link_to "← Back to Todos", todos_path, class: "back-link" %>
  </header>

  <div class="todo-form-container">
    <%= form_with model: @todo, local: true, class: "todo-form", data: { turbo: false } do |form| %>
      <div class="form-group">
        <%= form.label :title, class: "form-label" %>
        <%= form.text_field :title, class: "form-input form-input-title", required: true %>
      </div>
      
      <div class="form-group">
        <%= form.label :description, class: "form-label" %>
        <%= form.text_area :description, class: "form-input form-input-description", rows: 4 %>
      </div>
      
      <div class="form-group checkbox-group">
        <%= form.check_box :completed, class: "form-checkbox" %>
        <%= form.label :completed, "Mark as completed", class: "form-label checkbox-label" %>
      </div>
      
      <% if @todo.errors.any? %>
        <div class="error-messages">
          <% @todo.errors.full_messages.each do |message| %>
            <p class="error-message"><%= message %></p>
          <% end %>
        </div>
      <% end %>
      
      <div class="form-actions">
        <%= form.submit "Update Todo", class: "btn btn-primary" %>
        <%= link_to "Cancel", todos_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
